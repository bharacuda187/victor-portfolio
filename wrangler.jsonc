{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "portfolio",

  "main": "worker/index.ts",

  "compatibility_date": "2026-08-23",

  "workers_dev": false,

  "preview_urls": false,

  "routes": [
    {
      "pattern": "victortansingco.com",
      "custom_domain": true,
    },
  ],

  "ai": {
    "binding": "AI",
  },

  "ratelimits": [
    {
      "name": "CORE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/samples/*"],
  },
}
